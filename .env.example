PORT=4880
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4880
DATA_DIR=.data
NODE_ENV=development
# Resend requires a verified sender. Leave unset for a local development outbox.
RESEND_API_KEY=
EMAIL_FROM=

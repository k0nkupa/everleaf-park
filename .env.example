# Copy to .dev.vars for local Sites development. Keep secrets out of Git.
# Leave APP_ORIGIN empty locally to use the current request origin.
APP_ORIGIN=
# Email delivery is opt-in and requires a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated ChatGPT account emails allowed to review reports.
MODERATOR_EMAILS=
# Authenticated server-to-server image normalization.
IMAGE_PROCESSOR_URL=
IMAGE_PROCESSOR_TOKEN=

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "everleaf-image-processor",
  "account_id": "fe7043bad5e42be6f4b14b226c036749",
  "main": "worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "images": { "binding": "IMAGES" },
  "secrets": { "required": ["PROCESSOR_TOKEN"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
